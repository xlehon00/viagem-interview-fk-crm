# PostgreSQL, lokální hodnota viz README
DATABASE_URL=

# Přihlášení přes klubové SSO (JWT v cookie fk_session)
AUTH_JWT_SECRET=
AUTH_ISSUER=
AUTH_LOGIN_URL=

# Jen pro lokální vývoj (next dev): přihlásí uživatele s tímto e-mailem bez SSO
AUTH_DEV_EMAIL=

# Plánované úlohy /api/cron/*: volají se s hlavičkou Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
